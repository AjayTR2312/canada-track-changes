# ─── TR AI Platform Credentials ───
TR_WORKSPACE_ID=your-workspace-id-here
TR_ANTHROPIC_TOKEN_URL=https://your-token-endpoint-url/v1/anthropic/token

# ─── Anthropic API Key ───
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Azure OpenAI Credentials ───
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.azure-api.net
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2024-03-01-preview

# ─── AWS Credentials (use IAM role on EC2 if possible, else set these) ───
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# ─── S3 Configuration ───
S3_BUCKET_NAME=a209309-trackchanges-topical
PRESIGNED_URL_EXPIRY=3600

# ─── Pipeline Configuration ───
PIPELINE_MAX_WORKERS=6

# ─── API URL (for Streamlit to reach FastAPI) ───
API_URL=http://api:8000
