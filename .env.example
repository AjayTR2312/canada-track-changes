# ─── TR AI Platform Credentials ───
TR_WORKSPACE_ID=your-workspace-id-here
TR_ANTHROPIC_TOKEN_URL=https://your-token-endpoint-url/v1/anthropic/token

# ─── Anthropic API Key ───
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Azure OpenAI Credentials ───
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.azure-api.net
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2024-03-01-preview

# ─── AWS / S3: the ONLY persistent store ───
# Everything that must survive a pod restart is kept in this one bucket: job + batch records,
# uploads/outputs, validation sessions, users, usage and feedback logs. Pods keep only scratch files.
# NO access keys are needed when running inside the organisation: boto3 uses the pod's IAM role
# (IRSA / EKS Pod Identity / instance profile). Only set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# for local development outside AWS.
AWS_REGION=us-east-1
S3_BUCKET_NAME=a209309-s3-cdntrackchanges-653514985368-us-east-1-an
PRESIGNED_URL_EXPIRY=3600
# Optional: prefix every key (share one bucket between deployments), e.g. "canada/"
# S3_KEY_PREFIX=
# Optional: custom endpoint (VPC endpoint / LocalStack / MinIO)
# S3_ENDPOINT_URL=
# DEV/TEST ONLY: use a local folder as a fake bucket instead of S3 (no AWS needed)
# S3_LOCAL_DIR=C:\temp\fake-bucket

# ─── Job liveness (multi-pod) ───
# A running job's pod writes a heartbeat; another pod that finds it older than this marks the job
# "interrupted" (the pod was killed). Seconds.
# JOB_HEARTBEAT_SECONDS=20
# JOB_STALE_SECONDS=120

# ─── Pipeline Configuration ───
PIPELINE_MAX_WORKERS=6

# ─── Active Region Pack ───
# Selects which regions/<id>/region.yaml pack the app loads (name, products,
# DTD families shown in the UI via GET /api/region). Must match a folder under
# regions/ (e.g. canada, us_forms). Restart the API after changing this.
REGION_ID=canada

# ─── API URL (for Streamlit to reach FastAPI) ───
API_URL=http://api:8000

# ─── Completion e-mail (Microsoft Graph) ───
# Used ONLY to e-mail "processing completed" messages -- nothing is stored in SharePoint any more.
# Leave blank to disable the e-mail. EMAIL_FROM must be a mailbox in your tenant.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
EMAIL_FROM=
