# Kubernetes manifests
k8s/

# Build artifacts
build/
__pycache__/
*.pyc
*.pyo
*.spec

# Node / frontend build artifacts (frontend is built inside the Docker image)
node_modules/
**/node_modules/
frontend/dist/
docx-viewer-v2/**/dist/

# Local Python virtualenvs
.venv/
venv/
env/

# Local output folders
pipeline_jobs/
pipeline_output/

# finaloutputs: generated per-run data only; drop the whole folder from the image
finaloutputs/

# Dead code and standalone tools are not needed in the deployed image
legacy/
tools/

# Docker/compose files
Dockerfile
docker-compose.yml
.dockerignore

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# Docs
*.md
validation_prompts/

# Re-include runtime prompts (section_insertion.py loads prompts/ at runtime)
!prompts
!prompts/**

# Tests and dev requirements are not needed in the deployed image
tests/
requirements-dev.txt
