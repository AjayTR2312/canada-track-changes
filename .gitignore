# ─── Environment & Secrets ───
.env
.env.local
.env.production
*.pem
*.key

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ─── Logs ───
logs/
*.log
pipeline_log*.txt

# ─── Pipeline outputs & job data ───
pipeline_jobs/
pipeline_output/
# finaloutputs holds generated data, but the package's code is imported at runtime.
# Ignore the data, keep the two code files. Use /* (not /) so git can descend and
# honor the negations below — a plain "finaloutputs/" would exclude the whole dir.
finaloutputs/*
!finaloutputs/__init__.py
!finaloutputs/chapter_section.py

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo

# ─── OS files ───
Thumbs.db
.DS_Store
desktop.ini
~$*

# ─── Docker ───
docker-compose.override.yml

# ─── Misc ───
*.spec
failed_*.txt
