<!ENTITY % resize "resize (plus1 | plus2 | plus3 | minus1 | minus2 | minus3 | minus4 | minus5 | minus6 | same) 'same'">

         <!-- default for use in entry content -->

<!ENTITY % tbl.titles "tbl.name?,">
<!ENTITY % tbl.pretable "para*,">
<!ENTITY % tbl.posttable ", fixed.footnote.block?, tbl.note*">
<!ENTITY % tbl.tbl-main.mdl "(metadata.block?, %tbl.titles; (%tbl.pretable; table %tbl.posttable;)+)">
<!ENTITY % tbl.tbl.att "
          uuid          ID        #IMPLIED
          ident         CDATA     #IMPLIED
          position   (l|c|r)   'l' 
          table.width (25|33|50|66|75|90|100)   '100'
          orient     (port|land)   'port'
          brace.start  CDATA       #IMPLIED 
          brace.end    CDATA       #IMPLIED 
          elecwidth   NMTOKEN      #IMPLIED "> <!-- no greater than 220 --> 

<!ENTITY % tbl.table.name       "table">
<!ENTITY % tbl.table-main.mdl   "tgroup+">
<!ENTITY % tbl.table.mdl        "%tbl.table-main.mdl;">
<!ENTITY % tbl.table.att "
        pgwide NMTOKEN #IMPLIED 
        tabstyle (currency | figure | formcol | equation | text | textbrk) 'text'
        colgut CDATA #IMPLIED    
        rowgut CDATA #IMPLIED
        %resize; 
        emphasis (bold) #IMPLIED
        frame.rthick (.2 | .4 | .8) #IMPLIED 
        row.rthick (.2 | .4 | .8) #IMPLIED 
        col.rthick (.2 | .4 | .8) #IMPLIED ">

<!ENTITY % bodyatt              "
          uuid         ID        #IMPLIED
          stubst       NMTOKEN      #IMPLIED
          stubend      NMTOKEN      #IMPLIED">

<!ENTITY % tbl.tgroup.mdl "colspec*, thead?, tbody">
<!ENTITY % tbl.tgroup.att "
        tgroupstyle (currency | figure | formcol | equation | text) #IMPLIED    
        frame (top | bottom | topbot | all | left | right | sides | none) #IMPLIED
        stubst NMTOKEN #IMPLIED
        stubend NMTOKEN #IMPLIED
        colgut CDATA #IMPLIED
        rowgut CDATA #IMPLIED
        rowgut.alt1 CDATA #IMPLIED
        rowgut.alt2 CDATA #IMPLIED
        newpage (y | withseconly | withhier) #IMPLIED 
        left.indent CDATA #IMPLIED
        hyphen (n) #IMPLIED
        frame.rthick (.2 | .4 | .8) #IMPLIED
        row.rthick (.2 | .4 | .8) #IMPLIED 
        col.rthick (.2 | .4 | .8) #IMPLIED ">

<!ENTITY % tbl.thead.att "
        valign (top|middle|bottom|down) #IMPLIED
        rowgut CDATA #IMPLIED
        cont (n) #IMPLIED
        hyphen (y|n) #IMPLIED ">

<!ENTITY % tbl.tbody.mdl "(row | update.instr)+">

<!ENTITY % tbl.tbody.att "  
        valign (top|middle|bottom|down) #IMPLIED
        frame (topp | bottm | topbot | all | left | right | sides | none) #IMPLIED
        rowgut CDATA #IMPLIED
        hyphen (y|n) #IMPLIED
        frame.rthick (.2 | .4 | .8) #IMPLIED ">

<!ENTITY % tbl.colspec.att "
        colgut CDATA #IMPLIED 
        colstyle (currency) #IMPLIED 
        lvl (0|1|2|3|4|5) #IMPLIED
        row.rthick (.2 | .4 | .8) #IMPLIED 
        col.rthick (.2 | .4 | .8) #IMPLIED ">

<!ENTITY % tbl.row.mdl "entry+">

<!ENTITY % tbl.row.att "
        valign (top|middle|bottom|down) #IMPLIED
        rowgut CDATA #IMPLIED
        rowsep.no.gutter (underscore | dbluscore) #IMPLIED
        newpage (y) #IMPLIED
        row.rthick (.2 | .4 | .8) #IMPLIED 
		keep.with (next) #IMPLIED ">

<!ENTITY % tbl.entry.mdl "(%paracon;)*">

<!ENTITY % tbl.entry.att "
        valign (top|middle|bottom|down) #IMPLIED
        style (para|block|hang) 'block'
        indent NMTOKEN #IMPLIED 
        lvl (0|1|2|3|4|5) #IMPLIED
        hyphen (y|n) #IMPLIED
        rowsep.no.gutter (underscore | dbluscore) #IMPLIED
        row.rthick (.2 | .4 | .8) #IMPLIED 
        col.rthick (.2 | .4 | .8) #IMPLIED
        shade (10|20|30|40|50|100) #IMPLIED
        %resize; ">

<!ENTITY % tbl.name.content "((((label, designator?)|designator), name?)|name), tbl.name*">

<!ENTITY % tbl.note.content "name?, (para | list | update.instr)+">

<!-- ANALYTICAL XML TABLE DATA MODEL -->

<!ELEMENT tbl   %tbl.tbl-main.mdl;>
<!ATTLIST tbl
          cite.id			CDATA #IMPLIED
          crs.id			CDATA #IMPLIED
          %tbl.tbl.att;
          %update;
          %trace; 
          %formsmarker; >

<!ELEMENT table (%tbl.table.mdl;)>
<!ATTLIST table
        frame (top|bottom|topbot|all|left|right|sides|none) #IMPLIED 
        colsep %yesorno; #IMPLIED 
        rowsep %yesorno; #IMPLIED 
        %tbl.table.att;
        %bodyatt;>

<!ELEMENT tgroup (%tbl.tgroup.mdl;) >
<!ATTLIST tgroup
        cols            NMTOKEN                                #REQUIRED
        %tbl.tgroup.att;
        colsep          %yesorno;                              #IMPLIED
        rowsep          %yesorno;                              #IMPLIED
        align           (left|right|center|justify|char)       #IMPLIED>

<!ELEMENT colspec EMPTY >
<!ATTLIST colspec
        colnum          NMTOKEN                                #IMPLIED
        colname         NMTOKEN                                #IMPLIED
        colwidth        CDATA                                  #IMPLIED
        colsep          %yesorno;                              #IMPLIED
        rowsep          %yesorno;                              #IMPLIED
        align           (left|right|center|justify|char)       #IMPLIED
        char            CDATA                                  #IMPLIED
        charoff         NMTOKEN                                #IMPLIED
        %tbl.colspec.att;>

<!ELEMENT thead (row+)>
<!ATTLIST thead
        %tbl.thead.att;>

<!ELEMENT tbody %tbl.tbody.mdl; >
<!ATTLIST tbody
        %tbl.tbody.att; >

<!ELEMENT row (%tbl.row.mdl;)>
<!ATTLIST row
        rowsep          %yesorno;                  #IMPLIED
        cite.id		CDATA                      #IMPLIED
        crs.id		CDATA                      #IMPLIED
        %tbl.row.att;
        %update;
        %trace; >

<!ELEMENT entry  %tbl.entry.mdl;>
<!ATTLIST entry
        colname         NMTOKEN                                #IMPLIED
        namest          NMTOKEN                                #IMPLIED
        nameend         NMTOKEN                                #IMPLIED
        morerows        NMTOKEN                                #IMPLIED
        colsep          %yesorno;                              #IMPLIED
        rowsep          %yesorno;                              #IMPLIED
        align           (left|right|center|justify|char)       #IMPLIED
        char            CDATA                                  #IMPLIED
        charoff         NMTOKEN                                #IMPLIED
        cite.id		CDATA                                  #IMPLIED
        crs.id		CDATA                                  #IMPLIED
        %tbl.entry.att; >

<!ELEMENT tbl.name (%tbl.name.content;)>
<!ATTLIST tbl.name  
          align (left|right|center|justify|char) #IMPLIED
          cont (y) #IMPLIED
          pgwide (1) #IMPLIED
          %resize;
          %update;
          %trace; >

<!-- The tbl.note element accounts for both table notes and legends -->
<!ELEMENT tbl.note (%tbl.note.content;)>
<!ATTLIST tbl.note  
          align (left|right|center|justify|char) #IMPLIED
          %resize; >

