2.  The following parameter entities should not be declared elsewhere in a model that invokes this fragment:
		%bodyatt;
		%secur;
		%tbl.row.mdl;
		%tbl.table.att;
		%tbl.table.mdl;
		%tbl.tbl.att;
		%tbl.tbl-main.mdl;
		%tbl.tgroup.att;
		%tbl.tgroup.mdl;
		%yesorno;

3.  The following parameter entity declarations may be added to this fragment if deemed necessary: 

       ENTITY % secur              "
         border    (t|b|tandb|lft|rht|landr|allbdr|nobdr) #IMPLIED
         csstyle       NMTOKEN                             #IMPLIED
         rsstyle       NMTOKEN                             #IMPLIED
         bdrstyle.top  NMTOKEN                             #IMPLIED
         bdrstyle.bot  NMTOKEN                             #IMPLIED
         bdrstyle.lft  NMTOKEN                             #IMPLIED
         bdrstyle.rht  NMTOKEN                             #IMPLIED
         screen        CDATA                    #IMPLIED
         scrcolor      %tbl.screencolors; #IMPLIED
