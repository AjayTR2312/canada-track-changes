        lvl (0|1|2|3|4|5) #IMPLIED
        hyphen (y|n) #IMPLIED
        rowsep.no.gutter (underscore | dbluscore) #IMPLIED
        row.rthick (.2 | .4 | .8) #IMPLIED 
        col.rthick (.2 | .4 | .8) #IMPLIED
