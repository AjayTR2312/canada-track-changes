        row.rthick (.2 | .4 | .8) #IMPLIED 
        col.rthick (.2 | .4 | .8) #IMPLIED ">

<!ENTITY % tbl.thead.att "
        valign (top|middle|bottom|down) #IMPLIED
        rowgut CDATA #IMPLIED
        cont (n) #IMPLIED
        hyphen (y|n) #IMPLIED ">

<!ENTITY % tbl.tbody.mdl "(row | update.instr)+">

