<!-- ==== PAX TEXT MODELS MODIFIED FOR FM ==== -->          

<!ELEMENT footnote (footnote.reference, footnote.body )>
<!ATTLIST footnote  uuid    ID  #IMPLIED>

<!ELEMENT footnote.reference (%inline.text;)* >

<!ELEMENT footnote.body ((%section.text.structures;)*) >

<!ELEMENT fixed.footnote (fixed.footnote.reference, footnote.body) >

<!ELEMENT fixed.footnote.reference (%inline.text;)* >

<!ELEMENT fixed.footnote.block (fixed.footnote)+ >
<!ATTLIST fixed.footnote.block  
          fixed.footnote.page.style (2col) #IMPLIED >

<!ELEMENT leaveout.block (leaveout)>

<!ELEMENT leaveout   EMPTY >
<!ATTLIST leaveout  
          size  (x.small | small | medium | large | x.large | fill | full)    
                 'medium'  
          type (line | year | dollar | cents | percent | checkbox)  
               'line'  
          char (dots | asterisk | mdash | ndash )      #IMPLIED >

<!ELEMENT head  (name.block)>
<!ATTLIST head   %formats; >
          
<!ELEMENT name.block  ((label, designator?, name?) | (designator, name?)|  name)>

<!ELEMENT label (%inline.text;)* >

<!ELEMENT designator (%inline.text;)* >

<!ELEMENT name (%inline.text.and.footnotes; | set.as.keyed)*  >

<!ELEMENT para  (para.text | %text.structures;)* >
<!ATTLIST para  first.line (indent | none ) #IMPLIED
                %formats;
                intraline.leading NMTOKEN #IMPLIED >

<!ELEMENT para.text  (%inline.text.and.footnotes; | endpage)* >

<!ELEMENT omit.para (%inline.text.and.footnotes;)* >
<!ATTLIST omit.para     %formats;>

<!ELEMENT list ((name.block | head)?, para*, (list.item)+) >
<!ATTLIST list list.style (para | block | hang) 'block'
               list.item.desig (bull | bull2 | mdash | wbull | squ | squf | squ75 | squf75) #IMPLIED>

<!ELEMENT list.item ((name.block | head)?, (%list.structures; | list | para)+) >

<!ELEMENT quote.block  (quote.para | head |omit.para | list)+ > 

<!ELEMENT quote.para  (para.text | %text.structures;)+ >
<!ATTLIST quote.para    pstart (y|n) 'n' >

<!ELEMENT update.instr  (%inline.typographic; | leaveout)*  >

<!ELEMENT vertical.space EMPTY >
<!ATTLIST vertical.space
          leading NMTOKEN #REQUIRED >

