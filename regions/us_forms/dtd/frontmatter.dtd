<!ENTITY % tbl.table-main.mdl   "tgroup+">
<!ENTITY % tbl.table.mdl        "%tbl.table-main.mdl;">
<!ENTITY % tbl.table.att "
        pgwide NMTOKEN #IMPLIED 
        tabstyle (currency | figure | formcol | equation | text | textbrk) 'text'
        colgut CDATA #IMPLIED    
        rowgut CDATA #IMPLIED
        %resize; 
        frame.rthick (.2 | .4 | .8) #IMPLIED 
        row.rthick (.2 | .4 | .8) #IMPLIED 
        col.rthick (.2 | .4 | .8) #IMPLIED ">

<!ENTITY % bodyatt              "
          uuid         ID        #IMPLIED
          stubst       NMTOKEN      #IMPLIED
          stubend      NMTOKEN      #IMPLIED">

<!ENTITY % tbl.tgroup.mdl "colspec*, thead?, tbody">
<!ENTITY % tbl.tgroup.att "
        tgroupstyle (currency | figure | formcol | equation | text) #IMPLIED    
        frame (top | bottom | topbot | all | left | right | sides | none) #IMPLIED
        stubst NMTOKEN #IMPLIED
        stubend NMTOKEN #IMPLIED
        colgut CDATA #IMPLIED
        rowgut CDATA #IMPLIED
        rowgut.alt1 CDATA #IMPLIED
        rowgut.alt2 CDATA #IMPLIED
        newpage (y | withseconly) #IMPLIED 
        left.indent CDATA #IMPLIED
        hyphen (n) #IMPLIED
