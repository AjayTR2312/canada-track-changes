<!--WEST GROUP XML COMMON IMAGES DATA MODEL -->

<!-- This DTD fragment contains the declarations for elements that represent
images and components of images in West Group interchange data models -->

<!ELEMENT image.block ((update.instr?, name.block?, image.disclaimer?, image, head?, para*, image.text?)+)>
<!ATTLIST image.block
          rotate        (0 | 90 | 180 | 270)         #IMPLIED
          position      (float | fixed)              #IMPLIED
          newpage       (y | withhier | withseconly | rightstart) #IMPLIED
          pgwide        (1)                          #IMPLIED
          name.align    (l | c | r)                  #IMPLIED
          ct.id	     CDATA                          #IMPLIED
          %update;
          %trace;  >

<!ELEMENT image  EMPTY>
<!ATTLIST image
          original.id      CDATA                      #IMPLIED
          ident            CDATA                      #IMPLIED
          type             (photo | form | table | textblock | drawing | 
                            xray | map | screenshot| unknown) #IMPLIED
          color            (bw | color | graysc)      #IMPLIED
          format           (bmp | eps | gif | jpg | 
                            pcx | pdf | png | tif |
                            amz | cmp)		   'tif'
          resolut          (200 | 300 | 400 | 600)    #IMPLIED
          rotate           (0 | 90 | 180 | 270)       #IMPLIED
          height           CDATA                      #IMPLIED
          width            CDATA                      #IMPLIED
          units            (pi | in | cm | mm)        #IMPLIED
          scale            (scale | noscale)          #IMPLIED
          pgwide           (1)                        #IMPLIED
          align            (l)                        #IMPLIED
          discicon         (y)                        #IMPLIED
          suppress.print   (yes | no)                 'no'
          suppress.cd      (yes | no)                 'no'
          suppress.premise (yes | no)                 'no'
          suppress.focd    (yes | no)                 'no'
          suppress.folio   (yes | no)                 'no'
          suppress.online  (yes | no)                 'no'
          datelastupdated  CDATA                      #IMPLIED
          url              CDATA                      #IMPLIED
          file.system.path CDATA                      #IMPLIED
          status           CDATA                      #IMPLIED
          cite.id		  CDATA                      #IMPLIED
          crs.id		  CDATA                      #IMPLIED
          %update;
          %trace; >

<!ELEMENT image.text (%image.text.content;)*>
<!ATTLIST image.text
          refid	CDATA	#IMPLIED
          %update;
          %trace;   >

<!ELEMENT image.disclaimer (para+) >
<!ATTLIST image.disclaimer 
          suppress.cd      (yes | no) 'no'
          suppress.online  (yes | no) 'no'
          suppress.print   (yes | no) 'yes' >

