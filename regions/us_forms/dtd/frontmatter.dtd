<!ELEMENT volume.break (publication.date, primary.section.types?)>
<!ATTLIST volume.break
          name               CDATA    #IMPLIED
          item.number        CDATA    #IMPLIED
          chapter.cont.value CDATA    #IMPLIED
          topic.cont.value   CDATA    #IMPLIED
          part.cont.value    CDATA    #IMPLIED
          copyright          CDATA    #IMPLIED
          width              CDATA    #IMPLIED
          depth             CDATA    #IMPLIED
