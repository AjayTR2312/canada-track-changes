<!-- ==== ROOT ELEMENT ==== -->
<!ELEMENT front.data (volume.break+ | (volume+, (pubmeta | pubmeta.string)+)) >

<!-- Publication Metadata -->

<!ELEMENT pubmeta (%section.text.structures;)+>
